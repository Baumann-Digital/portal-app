{
  "name": "baudiApp",
  "version": "1.1.0",
  "description": "Web application for Baumann-Digital Portal",
  "main": "controller.xql",
  "repository": "https://github.com/Baumann-Digital/baudiApp.git",
  "author": "BauDi Team",
  "license": "MIT",
  "private": false,
  "scripts": {
    "watch": "sass --watch resources/sass/main.scss:resources/css/theme.css --style expanded --source-map",
    "compile": "sass resources/sass/main.scss:resources/css/theme.css --style expanded --source-map",
    "build": "sass resources/sass/main.scss:resources/css/theme.css --style compressed --no-source-map",
    "build:dev": "sass resources/sass/main.scss:resources/css/theme.css --style expanded --source-map",
    "postinstall": "./node_modules/.bin/frontend-dependencies",
    "test": "mocha"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.0.0",
    "bootstrap": "^4.5.3",
    "jquery": "^3.5.0",
    "waypoints": "^4.0.1"
  },
  "devDependencies": {
    "frontend-dependencies": "^0.4.0",
    "mocha": "^11.7.5",
    "sass": "^1.97.3"
  },
  "frontendDependencies": {
    "target": "libs",
    "packages": [
      "@fortawesome/fontawesome-free",
      "bootstrap/{js,scss,dist}",
      "jquery/dist/",
      "waypoints/lib"
    ]
  },
  "keywords": [
    "sass",
    "css",
    "baumann-digital",
    "exist-db"
  ]
}
